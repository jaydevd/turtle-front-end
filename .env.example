# Django server the Next.js dev proxy forwards /api/* to.
# Server-side only: never exposed to the browser bundle.
DJANGO_API_URL=http://127.0.0.1:8000

# Optional. The app uses same-origin /api by default so it goes through the
# proxy above. Only set this if you have configured CORS on Django instead.
# NEXT_PUBLIC_API_BASE_URL=/api
